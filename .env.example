# Copy to .env and fill in locally. Never commit .env.

# Postgres connection string (added when the first endpoint needs storage)
DATABASE_URL=

# Google AI Studio API key. Server-side only: never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=

# Gemini model id, chosen in PA#3
GEMINI_MODEL=

# Save-plan session signing secret: at least 32 random bytes. Backend only.
AUTH_SESSION_SECRET=

# Optional PA#2 SQLite file path; defaults to .data/plans.sqlite.
PLAN_STORE_PATH=
